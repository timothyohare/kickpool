{
  "runtime": "nextjs",
  "lint": "npm run lint",
  "typecheck": "npm run typecheck",
  "test": "npm test",
  "build": "npm run build",
  "boot": "npm run dev",
  "ready": "http://localhost:3000/api/health",
  "readyMatch": "\"ok\":true",
  "mockAws": "dynamodb-local",
  "setup": "npm run dynamo:init",
  "acceptance": "npm run verify:persistence",
  "env": {
    "DYNAMODB_ENDPOINT": "http://localhost:8000",
    "DYNAMODB_TABLE_PREFIX": "kickpool",
    "AWS_REGION": "ap-southeast-2"
  }
}
